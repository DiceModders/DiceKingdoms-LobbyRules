{
  // Texts of DiceKingdoms Lobby Rules: English is needed, other languages fall back to it. Languages: en, de, fr, ru, uk, zh-CN.
  // A file <DllName>.texts.json next to the DLL wins line by line, so players can fix or add texts without rebuilding.
  // rule.<key>.title / .description / .choice.<n> and group.<key>.title translate lobby rules and headings (ModCore).
  "group.lobbyrules.islands.title": { "en": "Islands", "de": "Inseln", "fr": "Îles", "ru": "Острова", "uk": "Острови", "zh-CN": "岛屿" },
  "rule.lobbyrules.islandGrid.title": { "en": "Island grid size", "de": "Inselrastergröße", "fr": "Taille de la grille des îles", "ru": "Размер сетки острова", "uk": "Розмір сітки острова", "zh-CN": "岛屿网格大小" },
  "rule.lobbyrules.islandGrid.description": { "en": "Tiles per side of every island. 49 = the game's islands. The land, its hills, forests, rocks and fish, and the space between islands grow with it. Up to 119 plays normally; 121 .. 201 is experimental and asks first.", "de": "Felder pro Seite jeder Insel. 49 = die Inseln des Spiels. Das Land, seine Hügel, Wälder, Felsen und Fische sowie der Abstand zwischen den Inseln wachsen mit. Bis 119 läuft alles normal; 121 .. 201 ist experimentell und fragt vorher.", "fr": "Cases par côté de chaque île. 49 = les îles du jeu. La terre, ses collines, forêts, rochers et poissons, ainsi que l'espace entre les îles grandissent avec. Jusqu'à 119 tout est normal ; 121 .. 201 est expérimental et demande d'abord.", "ru": "Клеток на сторону каждого острова. 49 = острова игры. Вместе с ним растут суша, её холмы, леса, скалы и рыба, а также расстояние между островами. До 119 игра идёт как обычно; 121 .. 201 — экспериментально, сначала будет вопрос.", "uk": "Клітинок на бік кожного острова. 49 = острови гри. Разом із ним ростуть суходіл, його пагорби, ліси, скелі й риба, а також відстань між островами. До 119 гра йде як звичайно; 121 .. 201 — експериментально, спершу буде запитання.", "zh-CN": "每个岛屿每边的格数。49 = 游戏原本的岛屿。陆地、丘陵、森林、岩石、鱼以及岛屿间距都会随之变大。119 以内正常游戏；121 .. 201 为实验性，会先询问。" },
  "rule.lobbyrules.landSize.title": { "en": "Land size %", "de": "Landgröße %", "fr": "Taille des terres %", "ru": "Размер суши %", "uk": "Розмір суходолу %", "zh-CN": "陆地大小 %" },
  "rule.lobbyrules.landSize.description": { "en": "How much of the island grid is land. 100 = like the game's islands.", "de": "Wie viel des Inselrasters Land ist. 100 = wie die Inseln des Spiels.", "fr": "Part de la grille de l'île qui est de la terre. 100 = comme les îles du jeu.", "ru": "Какая часть сетки острова — суша. 100 = как у островов игры.", "uk": "Яка частина сітки острова — суходіл. 100 = як в островів гри.", "zh-CN": "岛屿网格中陆地所占的比例。100 = 与游戏原本的岛屿相同。" },
  "islands.experimental": { "en": "Island grid {0} is in the experimental range ({1} .. {2}).\n\nExpect a long freeze while the islands are built and slower computer turns, and every player's PC needs to keep up. Use it?", "de": "Inselraster {0} liegt im experimentellen Bereich ({1} .. {2}).\n\nRechne mit einem langen Stocken, während die Inseln gebaut werden, und langsameren Computerzügen; jeder Spieler-PC muss mithalten. Verwenden?", "fr": "La grille d'île {0} est dans la plage expérimentale ({1} .. {2}).\n\nAttendez-vous à un long blocage pendant la construction des îles et à des tours d'ordinateur plus lents ; le PC de chaque joueur doit suivre. L'utiliser ?", "ru": "Сетка острова {0} — в экспериментальном диапазоне ({1} .. {2}).\n\nОжидайте долгого зависания, пока строятся острова, и более медленных ходов компьютерных игроков; ПК каждого игрока должен справиться. Использовать?", "uk": "Сітка острова {0} — в експериментальному діапазоні ({1} .. {2}).\n\nОчікуйте довгого зависання, поки будуються острови, і повільніших ходів комп'ютерних гравців; ПК кожного гравця має впоратися. Використати?", "zh-CN": "岛屿网格 {0} 处于实验范围（{1} .. {2}）。\n\n生成岛屿时会长时间卡顿，电脑玩家的回合也会变慢，而且每位玩家的电脑都需要跟得上。要使用吗？" },
